{
  "name": "ledger-event-sourcing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Projeto de aprendizagem de ledger para fintechs com Event Sourcing.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:backend": "tsx watch src/backend/index.ts",
    "dev:frontend": "vite",
    "build:frontend": "vite build",
    "preview:frontend": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "express": "^5.0.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.21.0",
    "vite": "^6.0.7",
    "vitest": "^3.2.4"
  }
}
